# روشن کردن موتور بازنویسی لینک‌ها
RewriteEngine On

# تنظیم صفحه پیش‌فرض روی index.php
DirectoryIndex home.php index.php

# جلوگیری از نمایش لیست فایل‌های پوشه (امنیت)
Options -Indexes

# اجازه دسترسی به تمام فایل‌های PHP, CSS, JS, Images
<FilesMatch "\.(php|css|js|jpg|jpeg|png|gif|ico)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# جلوگیری از دسترسی به فایل‌های حساس
<FilesMatch "^\.ht">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# جلوگیری از دسترسی به فایل‌های کنفیگ و env
<FilesMatch "\.(env|config|json)$|^\.|\.sql$|\.git">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# هدرهای امنیتی
<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
